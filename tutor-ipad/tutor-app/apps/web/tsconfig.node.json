{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsnode",
    "types": [
      "node"
    ]
  },
  "include": [
    "e2e",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}