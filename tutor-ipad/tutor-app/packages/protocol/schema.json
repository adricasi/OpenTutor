{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InkTutorProtocol",
  "type": "object",
  "properties": {
    "Anchor": {
      "$ref": "#/$defs/Anchor"
    },
    "BBox": {
      "$ref": "#/$defs/BBox"
    },
    "CheckResult": {
      "$ref": "#/$defs/CheckResult"
    },
    "ClientMessage": {
      "$ref": "#/$defs/ClientMessage"
    },
    "ErrorMsg": {
      "$ref": "#/$defs/ErrorMsg"
    },
    "FeedbackEvent": {
      "$ref": "#/$defs/FeedbackEvent"
    },
    "FeedbackMsg": {
      "$ref": "#/$defs/FeedbackMsg"
    },
    "GhostAction": {
      "$ref": "#/$defs/GhostAction"
    },
    "Graph": {
      "$ref": "#/$defs/Graph"
    },
    "GraphEdge": {
      "$ref": "#/$defs/GraphEdge"
    },
    "GraphNode": {
      "$ref": "#/$defs/GraphNode"
    },
    "HintRequest": {
      "$ref": "#/$defs/HintRequest"
    },
    "InkUpdate": {
      "$ref": "#/$defs/InkUpdate"
    },
    "LineCorrection": {
      "$ref": "#/$defs/LineCorrection"
    },
    "MarkDismiss": {
      "$ref": "#/$defs/MarkDismiss"
    },
    "PageRef": {
      "$ref": "#/$defs/PageRef"
    },
    "QuestionAnswer": {
      "$ref": "#/$defs/QuestionAnswer"
    },
    "Reading": {
      "$ref": "#/$defs/Reading"
    },
    "ReadingLine": {
      "$ref": "#/$defs/ReadingLine"
    },
    "ReadingMsg": {
      "$ref": "#/$defs/ReadingMsg"
    },
    "RuntimeMsg": {
      "$ref": "#/$defs/RuntimeMsg"
    },
    "RuntimeStatus": {
      "$ref": "#/$defs/RuntimeStatus"
    },
    "ServerMessage": {
      "$ref": "#/$defs/ServerMessage"
    },
    "Session": {
      "$ref": "#/$defs/Session"
    },
    "SessionMsg": {
      "$ref": "#/$defs/SessionMsg"
    },
    "SessionUpdate": {
      "$ref": "#/$defs/SessionUpdate"
    },
    "StatusMsg": {
      "$ref": "#/$defs/StatusMsg"
    },
    "Stroke": {
      "$ref": "#/$defs/Stroke"
    },
    "SymbolSpan": {
      "$ref": "#/$defs/SymbolSpan"
    },
    "TutorInfo": {
      "$ref": "#/$defs/TutorInfo"
    },
    "VoiceAudio": {
      "$ref": "#/$defs/VoiceAudio"
    },
    "VoiceAudioOut": {
      "$ref": "#/$defs/VoiceAudioOut"
    },
    "VoiceDictate": {
      "$ref": "#/$defs/VoiceDictate"
    },
    "VoiceStop": {
      "$ref": "#/$defs/VoiceStop"
    },
    "VoiceTranscript": {
      "$ref": "#/$defs/VoiceTranscript"
    }
  },
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stroke_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Anchor",
      "type": "object"
    },
    "BBox": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "BBox",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "detail": {
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "ok",
        "kind",
        "anchor",
        "detail"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "ClientMessage": {
      "title": "ClientMessage",
      "oneOf": [
        {
          "$ref": "#/$defs/InkUpdate"
        },
        {
          "$ref": "#/$defs/HintRequest"
        },
        {
          "$ref": "#/$defs/QuestionAnswer"
        },
        {
          "$ref": "#/$defs/GhostAction"
        },
        {
          "$ref": "#/$defs/MarkDismiss"
        },
        {
          "$ref": "#/$defs/SessionUpdate"
        },
        {
          "$ref": "#/$defs/VoiceAudio"
        },
        {
          "$ref": "#/$defs/VoiceStop"
        },
        {
          "$ref": "#/$defs/LineCorrection"
        },
        {
          "$ref": "#/$defs/VoiceDictate"
        }
      ]
    },
    "ErrorMsg": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "error",
          "default": "error",
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "ErrorMsg",
      "type": "object"
    },
    "FeedbackEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "type": {
          "enum": [
            "mark",
            "ghost",
            "hint",
            "question",
            "speak",
            "explain",
            "summary",
            "retract"
          ],
          "type": "string"
        },
        "glyph": {
          "anyOf": [
            {
              "enum": [
                "check",
                "cross",
                "question",
                "pin",
                "underline",
                "circle"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "ok",
                "minor",
                "major"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hint_level": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "refers_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "default": "tutor",
          "enum": [
            "checker",
            "tutor",
            "recognizer"
          ],
          "type": "string"
        },
        "choices": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "page_id",
        "anchor",
        "type"
      ],
      "title": "FeedbackEvent",
      "type": "object"
    },
    "FeedbackMsg": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "feedback",
          "default": "feedback",
          "type": "string"
        },
        "feedback": {
          "$ref": "#/$defs/FeedbackEvent"
        },
        "provider": {
          "default": "",
          "type": "string"
        },
        "model": {
          "default": "",
          "type": "string"
        },
        "ms": {
          "default": 0,
          "type": "number"
        }
      },
      "required": [
        "feedback"
      ],
      "title": "FeedbackMsg",
      "type": "object"
    },
    "GhostAction": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ghost.accept",
            "ghost.dismiss"
          ],
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "feedback_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "page_id",
        "feedback_id"
      ],
      "title": "GhostAction",
      "type": "object"
    },
    "Graph": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "type": "array"
        },
        "edges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "type": "array"
        }
      },
      "title": "Graph",
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "src": {
          "type": "string"
        },
        "dst": {
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "directed": {
          "default": true,
          "type": "boolean"
        },
        "stroke_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "src",
        "dst"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "stroke_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "shape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "label",
        "bbox",
        "stroke_ids"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "HintRequest": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "hint.request",
          "default": "hint.request",
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "feedback_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "level": {
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        },
        "explicit": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "page_id",
        "level"
      ],
      "title": "HintRequest",
      "type": "object"
    },
    "InkUpdate": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "ink.update",
          "default": "ink.update",
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "strokes_changed": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Stroke"
          },
          "type": "array"
        },
        "strokes_removed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "page": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "page_id"
      ],
      "title": "InkUpdate",
      "type": "object"
    },
    "LineCorrection": {
      "additionalProperties": false,
      "description": "\"Tell the tutor what you meant\": what a line really says, typed (or dictated) by the student from a question\nchip or a \"?\" mark. Only the reading changes; the ink is never touched.",
      "properties": {
        "type": {
          "const": "line.correction",
          "default": "line.correction",
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "line_id": {
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "default": "typed",
          "enum": [
            "typed",
            "spoken"
          ],
          "type": "string"
        }
      },
      "required": [
        "page_id",
        "line_id",
        "text"
      ],
      "title": "LineCorrection",
      "type": "object"
    },
    "MarkDismiss": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "mark.dismiss",
          "default": "mark.dismiss",
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "feedback_id": {
          "type": "string"
        }
      },
      "required": [
        "page_id",
        "feedback_id"
      ],
      "title": "MarkDismiss",
      "type": "object"
    },
    "PageRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "integer"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "index",
        "width",
        "height"
      ],
      "title": "PageRef",
      "type": "object"
    },
    "QuestionAnswer": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "question.answer",
          "default": "question.answer",
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "feedback_id": {
          "type": "string"
        },
        "reading_line_id": {
          "type": "string"
        },
        "chosen": {
          "type": "string"
        }
      },
      "required": [
        "page_id",
        "feedback_id",
        "reading_line_id",
        "chosen"
      ],
      "title": "QuestionAnswer",
      "type": "object"
    },
    "Reading": {
      "additionalProperties": false,
      "properties": {
        "page_id": {
          "type": "string"
        },
        "lines": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReadingLine"
          },
          "type": "array"
        },
        "graph": {
          "anyOf": [
            {
              "$ref": "#/$defs/Graph"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "default": 0,
          "type": "integer"
        }
      },
      "required": [
        "page_id"
      ],
      "title": "Reading",
      "type": "object"
    },
    "ReadingLine": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "stroke_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "kind": {
          "enum": [
            "math",
            "text",
            "label",
            "long_division"
          ],
          "type": "string"
        },
        "latex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "alternatives": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "symbol_map": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SymbolSpan"
          },
          "type": "array"
        },
        "structure": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "corrected": {
          "anyOf": [
            {
              "enum": [
                "typed",
                "spoken"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "stroke_ids",
        "bbox",
        "kind",
        "confidence"
      ],
      "title": "ReadingLine",
      "type": "object"
    },
    "ReadingMsg": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "reading",
          "default": "reading",
          "type": "string"
        },
        "reading": {
          "$ref": "#/$defs/Reading"
        },
        "ms": {
          "default": 0,
          "type": "number"
        }
      },
      "required": [
        "reading"
      ],
      "title": "ReadingMsg",
      "type": "object"
    },
    "RuntimeMsg": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "runtime",
          "default": "runtime",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RuntimeStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "RuntimeMsg",
      "type": "object"
    },
    "RuntimeStatus": {
      "additionalProperties": false,
      "properties": {
        "available_gb": {
          "type": "number"
        },
        "level": {
          "enum": [
            "ok",
            "low",
            "critical"
          ],
          "type": "string"
        },
        "tier2_model": {
          "type": "string"
        },
        "tier2_mode": {
          "enum": [
            "full",
            "offload",
            "refused",
            "external",
            "loading",
            "unavailable",
            "off"
          ],
          "type": "string"
        },
        "detail": {
          "default": "",
          "type": "string"
        },
        "event": {
          "default": "",
          "type": "string"
        },
        "event_id": {
          "default": 0,
          "type": "integer"
        }
      },
      "required": [
        "available_gb",
        "level",
        "tier2_model",
        "tier2_mode"
      ],
      "title": "RuntimeStatus",
      "type": "object"
    },
    "ServerMessage": {
      "title": "ServerMessage",
      "oneOf": [
        {
          "$ref": "#/$defs/SessionMsg"
        },
        {
          "$ref": "#/$defs/ReadingMsg"
        },
        {
          "$ref": "#/$defs/FeedbackMsg"
        },
        {
          "$ref": "#/$defs/StatusMsg"
        },
        {
          "$ref": "#/$defs/VoiceTranscript"
        },
        {
          "$ref": "#/$defs/VoiceAudioOut"
        },
        {
          "$ref": "#/$defs/ErrorMsg"
        },
        {
          "$ref": "#/$defs/RuntimeMsg"
        }
      ]
    },
    "Session": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "math",
            "diagram",
            "system_design",
            "consulting",
            "language",
            "accounting",
            "sudoku",
            "other"
          ],
          "type": "string"
        },
        "problem": {
          "default": "",
          "type": "string"
        },
        "rubric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider": {
          "default": "local",
          "enum": [
            "local",
            "anthropic",
            "openai"
          ],
          "type": "string"
        },
        "voice": {
          "default": false,
          "type": "boolean"
        },
        "pages": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PageRef"
          },
          "type": "array"
        },
        "keep_history": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "mode"
      ],
      "title": "Session",
      "type": "object"
    },
    "SessionMsg": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "session",
          "default": "session",
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/Session"
        },
        "tier2": {
          "$ref": "#/$defs/TutorInfo"
        }
      },
      "required": [
        "session",
        "tier2"
      ],
      "title": "SessionMsg",
      "type": "object"
    },
    "SessionUpdate": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "session.update",
          "default": "session.update",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "enum": [
                "local",
                "anthropic",
                "openai"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "voice": {
          "anyOf": [
            {
