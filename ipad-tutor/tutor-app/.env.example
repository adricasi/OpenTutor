# Tier-2 providers. Local is the default and needs no key.
TUTOR_PROVIDER=local            # local | anthropic | openai

# Local tier-2 model: pick one key from models/manifest.toml [tier2.*]
LOCAL_MODEL=gemma4-26b-a4b      # gemma4-26b-a4b | qwen36-35b-a3b | qwen38-27b
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8080/v1   # mlx-vlm / LM Studio OpenAI-compatible endpoint
LOCAL_SERVER_MANAGED=true       # true: apps/server/runtime starts/restarts mlx-vlm with LOCAL_MODEL; false: you run it yourself

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5


# Teacher view (/teacher). LAN/localhost only; set a token to also reach it through the tunnel with ?t=<token>
TEACHER_TOKEN=
