# Copy to .env for local development. Never commit .env.
# Real secrets belong in GCP Secret Manager; this file documents variable names only.
APP_ENV=development
LOG_LEVEL=info
# Optional: the iPad handwriting tutor (ipad-tutor/) that the hub's /ipad page redirects to.
# An absolute http:// or https:// URL, e.g. http://<mac>.local:8000 on the LAN, or the HTTPS
# link that `make ipad` prints (the iPad microphone needs HTTPS). Empty = not connected.
# The hub reads it from the environment or as ipad_url in opentutor.toml (not from .env).
OPENTUTOR_IPAD_URL=
